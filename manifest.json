{
	"display_information": {
		"name": "RiddleBot"
	},
	"features": {
		"bot_user": {
			"display_name": "RiddleBot",
			"always_online": false
		},
		"slash_commands": [
			{
				"command": "/riddle-me-this",
				"description": "Gives you a riddle",
				"should_escape": false
			},
			{
				"command": "/riddlebot-ping",
				"description": "Is riddlebot alive?",
				"should_escape": false
			},
			{
				"command": "/riddlebot-help",
				"description": "need Help using riddlebot?",
				"should_escape": false
			},
			{
				"command": "/riddlebot-catfact",
				"description": "Get a Cat Fact",
				"should_escape": false
			}
		]
	},
	"oauth_config": {
		"scopes": {
			"bot": ["chat:write", "commands", "app_mentions:read", "channels:history"]
		},
		"pkce_enabled": false
	},
	"settings": {
		"interactivity": {
			"is_enabled": true
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": true,
		"token_rotation_enabled": false,
		"app_level_token_rotation_enabled": false,
		"is_mcp_enabled": false
	}
}
